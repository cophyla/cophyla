node_modules/
*.log
.env
dist/
# the controller's native web bundle, copied into the Android and iOS projects by `cap sync`
apps/controller/dist-native/
*.tsbuildinfo
# generated JSON Schema dump
packages/protocol/schema/
# spike scratch: downloaded models, captured audio, run output that may hold session tokens
spikes/**/models/
spikes/**/out/
spikes/**/*.wav
spikes/**/.venv/
spikes/**/target/
# cophyla-net's cargo output
apps/net/target/
# the desktop shell's cargo output and Tauri's generated ACL schemas and permissions
apps/ui/src-tauri/target/
apps/ui/src-tauri/gen/
apps/ui/src-tauri/permissions/autogenerated/
# the closed brain: born in its own repository, never part of the public tree
brain/
# the closed server: born in its own repository, never part of the public tree
apps/server/
# the design notes, all private (the architecture, the entities, the build order, the brain's
# loop, the research): a repository of their own
.docs/
# the installer's cargo output and everything a release build stages (version trees, the
# brain seed, archives, the feed); the release key and the certificate live outside the tree
apps/installer/src-tauri/target/
apps/installer/src-tauri/gen/
apps/installer/stage/
# Claude Code worktrees and session files
.claude/
# screenshots the Playwright MCP browser leaves where it was run
.playwright-mcp/

# the embedding model, fetched by apps/cophylad/scripts/fetch-models.ts and staged into the
# release, and the voice models, which are `model` releases of their own
apps/cophylad/models/
# the speech sidecar ships as sources and locks; an environment built from its README by hand
# is scratch, and the daemon builds its own under ~/.cophyla/data/sidecars
sidecars/**/.venv/
sidecars/**/__pycache__/
sidecars/**/out/
