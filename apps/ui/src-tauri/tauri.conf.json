{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cophyla",
  "version": "0.13.0",
  "identifier": "com.fareaststudios.cophyla.desktop",
  "mainBinaryName": "cophyla-ui",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "bun run build:host",
    "beforeBuildCommand": "bun run build:host"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src http://view.localhost view://localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
